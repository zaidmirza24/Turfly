PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/turf_booking
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
NODE_ENV=development
ADMIN_EMAIL=admin@turf.local
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Platform Admin

# Comma-separated list of browser origins allowed to call this API
# (e.g. https://turfly.vercel.app,http://localhost:5173).
# Leave blank to allow any origin — fine locally. Required in production —
# the server refuses to start without it (env.js).
CORS_ORIGINS=

# Log verbosity: debug | info | warn | error | silent.
# Defaults to "info" in production and "debug" everywhere else.
LOG_LEVEL=

# Largest accepted image upload, in bytes. Default 10485760 (10 MB).
# Masters are stored on ImageKit (see below), not in MongoDB, so this only
# needs to keep uploads fast on mobile networks — not fit a DB document limit.
MAX_IMAGE_BYTES=

# ── ImageKit (turf photo storage + delivery CDN) ──
# Dashboard → Developer options → API keys / URL endpoint
# (https://imagekit.io/dashboard/developer/api-keys).
# Required in production — the server refuses to start without all three
# (env.js). Turf photo uploads/serving are broken until these are set.
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# ── Razorpay (payments) ──
# Get these from the Razorpay Dashboard → Settings → API Keys.
# Use the "Test Mode" key pair for development, "Live Mode" for production —
# they are entirely separate credential pairs, never the same value.
# RAZORPAY_KEY_ID is the only one of these ever sent to the browser (via the
# create-order API response) — RAZORPAY_KEY_SECRET and
# RAZORPAY_WEBHOOK_SECRET must never leave the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks → (create one pointing at
# https://<your-api-domain>/api/payments/webhook) → copy its secret here.
# Required in production whenever RAZORPAY_KEY_ID is set — the server refuses
# to start otherwise (env.js).
RAZORPAY_WEBHOOK_SECRET=

# Minutes a slot stays reserved once a Razorpay order has been created for it
# (separate from, and longer than, the 5-minute browse-to-checkout lock).
# Default 10.
PAYMENT_RESERVATION_MINUTES=10

# Flat platform commission taken out of every ONLINE booking (0.10 = 10%).
# Computed once per booking at confirmation time and stored on it, so
# changing this only affects bookings confirmed afterward, never rewrites
# history. Must be >= 0 and < 1. Default 0.1.
PLATFORM_COMMISSION_RATE=0.1

# ── Brevo (transactional email) ──
# Dashboard → SMTP & API → API Keys.
BREVO_API_KEY=
# Must be a verified sender in Brevo (Senders, Domains & Dedicated IPs →
# Senders) — Brevo rejects sends from an unverified address.
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Turf Booking
# Optional: Dashboard → Webhooks → create one pointing at
# https://<your-api-domain>/api/notifications/webhooks/brevo, copy its secret.
BREVO_WEBHOOK_SECRET=

# Used to build links inside emails (e.g. "View booking").
FRONTEND_URL=http://localhost:5173

# Shown in email footers and on the payment-failure screen.
SUPPORT_EMAIL=

# ── Onboarding email OTP ──
# Minutes an OTP stays valid after being sent. Default 10.
OTP_EXPIRY_MINUTES=10
# TESTING ONLY. When set, this exact code verifies ANY email's OTP instead of
# the real emailed code — lets QA/automation skip reading real inboxes.
# Only ever consulted when NODE_ENV is NOT "production" (hardcoded in
# auth.service.js) — leaving this set in a production .env by mistake still
# cannot open the backdoor there. Leave blank to disable even in dev.
OTP_MASTER_CODE=000000
