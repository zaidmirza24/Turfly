PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/turf_booking
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
NODE_ENV=development
ADMIN_EMAIL=admin@turf.local
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Platform Admin

# Optional: protects GET /api/cron/slot-cleanup from being triggered by
# anyone who finds the URL. Set the same value here and in Vercel's env
# vars — Vercel Cron automatically sends it as `Authorization: Bearer <value>`.
# Leave blank locally; the check is skipped when this is unset.
CRON_SECRET=
