PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/turf_booking
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
NODE_ENV=development
ADMIN_EMAIL=admin@turf.local
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Platform Admin

# Comma-separated list of browser origins allowed to call this API
# (e.g. https://turfly.vercel.app,http://localhost:5173).
# Leave blank to allow any origin — fine locally, tighten in production.
CORS_ORIGINS=

# Log verbosity: debug | info | warn | error | silent.
# Defaults to "info" in production and "debug" everywhere else.
LOG_LEVEL=

# Largest accepted image upload, in bytes. Default 2097152 (2 MB).
# Keep it well under MongoDB's 16 MB per-document limit — uploads are stored
# as binary in the database (see src/modules/image/image.model.js).
MAX_IMAGE_BYTES=
